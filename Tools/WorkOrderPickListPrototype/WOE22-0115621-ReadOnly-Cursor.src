0010 REM "WORKORDER-RELEASED-BOM-004 single-WO O_RDONLY cursor reader"
0020 REM "DEVELOPMENT ONLY. TARGET IS FIXED TO WORK ORDER 0115621."
0030 SETESC 29000
0040 SETERR 29000
0050 PRECISION 16
0060 LET ROOT$="C:\Add-On\Lab\WorkOrderReleasedBom004\",Q$=$22$,CH10=0,OUT20=0
0070 LET PREFIX$="01  0115621B",COUNT=0,MSGS=0
0080 DIM W0$(15),W1$(151),W[13]
0090 WOE22A: IOLIST W0$(1),W1$(1),W[ALL]
0100 OPEN (10,MODE="O_RDONLY",ERR=29100)"X:\AON\ADATA\WOE-22";LET CH10=1
0110 LET FID1$=FID(10),FIN1$=FIN(10)
0120 OPEN (20,MODE="O_CREATE,O_TRUNC",ERR=29200)ROOT$+"WOE22_0115621.csv";LET OUT20=1
0130 PRINT (20)"source_key_hex,w0_hex,w1_hex,n00,n01,n02,n03,n04,n05,n06,n07,n08,n09,n10,n11,n12,n13"
0140 READ (10,KEY=PREFIX$,DOM=0150)
0150 LET K$=KEY(10,END=1800)
0160 IF K$(1,12)<>PREFIX$ THEN GOTO 1800
0170 FIND (10,KEY=K$,ERR=29400)IOL=WOE22A
0180 LET LINE$=Q$+HTA(K$)+Q$+","+Q$+HTA(W0$)+Q$+","+Q$+HTA(W1$)+Q$
0190 FOR X=0 TO 13;LET LINE$=LINE$+","+Q$+STR(W[X])+Q$;NEXT X
0200 PRINT (20)LINE$;LET COUNT=COUNT+1;IF W1$(91,1)="M" THEN LET MSGS=MSGS+1
0210 GOTO 150
1800 LET FID2$=FID(10),FIN2$=FIN(10)
1810 CLOSE (10);LET CH10=0
1820 CLOSE (20);LET OUT20=0
1830 IF COUNT<>100 OR MSGS<>48 THEN LET MSG$="expected 100 total and 48 messages";GOTO 29500
1840 OPEN (20,MODE="O_CREATE,O_TRUNC",ERR=29200)ROOT$+"RUNTIME_VERDICT.txt";LET OUT20=1
1850 PRINT (20)"qualification_verdict=PASS";PRINT (20)"source=WOE-22";PRINT (20)"source_mode=O_RDONLY";PRINT (20)"prefix_hex="+HTA(PREFIX$);PRINT (20)"record_count="+STR(COUNT);PRINT (20)"message_count="+STR(MSGS);PRINT (20)"identity_unchanged="+STR(FID1$=FID2$ AND FIN1$=FIN2$)
1860 CLOSE (20);LET OUT20=0
1870 RELEASE
29000 LET MSG$="unexpected runtime error "+STR(ERR);GOTO 29500
29100 LET MSG$="O_RDONLY source open failed "+STR(ERR);GOTO 29500
29200 LET MSG$="local output open failed "+STR(ERR);GOTO 29500
29400 LET MSG$="record read failed "+STR(ERR);GOTO 29500
29500 IF CH10=1 THEN CLOSE (10)
29510 IF OUT20=1 THEN CLOSE (20)
29520 OPEN (20,MODE="O_CREATE,O_TRUNC",ERR=29560)ROOT$+"RUNTIME_VERDICT.txt"
29530 PRINT (20)"qualification_verdict=FAIL";PRINT (20)"failure="+MSG$;CLOSE (20)
29540 ESCAPE
29560 PRINT "qualification failed and local verdict could not be written"
29570 ESCAPE
