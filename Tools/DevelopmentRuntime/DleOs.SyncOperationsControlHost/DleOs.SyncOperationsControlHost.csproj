<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DleOs.SyncOperationsControlHost</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    This is a dedicated DEV boundary. Only Sync Operations routing, identity,
    authorization, admission, durable state, and worker-launch sources are
    compiled. No 5054 operational routes or 5043 refresh surfaces are linked.
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ControlHostRuntimeConfiguration.cs" />
    <Compile Include="WorkerDependencyManifest.cs" />
    <Compile Include="WorkerIdentityPreflight.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\SyncOperationsCenter.cs"
             Link="SyncOperations\SyncOperationsCenter.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\SyncOperationsStatusSnapshot.cs"
             Link="SyncOperations\SyncOperationsStatusSnapshot.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\TrustedDevelopmentIdentity.cs"
             Link="Security\TrustedDevelopmentIdentity.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\DevelopmentPermissionAuthorization.cs"
             Link="Security\DevelopmentPermissionAuthorization.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <ProjectReference Include="..\..\SecurityFoundation\DleOs.Security\DleOs.Security.csproj" />
    <ProjectReference Include="..\..\TrustedIdentity\DleOs.TrustedIdentity\DleOs.TrustedIdentity.csproj" />
    <Content Update="worker-dependencies.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Start-SyncOperationsControlHost5056.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
