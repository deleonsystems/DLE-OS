{
  "manifest_version": 3,
  "name": "DLE-OS Governed Desktop Capabilities (DEV)",
  "version": "0.1.0",
  "description": "DEV-only broker for explicit governed DLE-OS desktop capabilities.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://dev.dle-os.internal.dlemfg.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dev.dle-os.internal.dlemfg.com/*"
      ],
      "js": [
        "contract.js",
        "content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
