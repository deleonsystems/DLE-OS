<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DleOs.GovernedRefreshControlHost</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ControlHostRuntimeConfiguration.cs" />
    <Compile Include="TrustedRefreshIdentity.cs" />
    <Compile Include="RefreshPermissionAuthorization.cs" />
    <Compile Include="InvoiceHistoryRefreshCenter.cs" />
    <Compile Include="NormalUserProcess.cs" />
    <Compile Include="WorkerDependencyManifest.cs" />
    <Compile Include="WorkerIdentityPreflight.cs" />
    <Compile Include="QualificationExecutionCenter.cs" />
    <Compile Include="HostInstanceIdentity.cs" />
    <Compile Include="LiveRunApprovalStore.cs" />
    <Compile Include="LiveApprovalQualificationCenter.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <ProjectReference Include="..\..\SecurityFoundation\DleOs.Security\DleOs.Security.csproj" />
    <ProjectReference Include="..\..\TrustedIdentity\DleOs.TrustedIdentity\DleOs.TrustedIdentity.csproj" />
    <Content Update="worker-dependencies.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Start-GovernedRefreshControlHost.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Invoke-InvoiceHistoryFailureQualification.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="New-FailurePreservationQualificationApproval.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="New-OneRunLiveApproval.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="New-OneRunApprovalQualification.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="qualification-fixtures.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="qualification-dependency-fixture.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
