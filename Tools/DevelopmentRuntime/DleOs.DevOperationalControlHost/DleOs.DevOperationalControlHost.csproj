<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DleOs.DevOperationalControlHost</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);DLE_OS_DEV_ONLY</DefineConstants>
  </PropertyGroup>

  <!--
    This is an explicit security boundary. Only DEV operational route sources
    listed here are compiled into the 5054 executable. Refresh, synchronization,
    qualification-launcher, and production-control sources are intentionally absent.
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="DevResilienceLogging.cs" />
    <Compile Include="Dev5054WindowsServiceBootstrap.cs" />
    <Compile Include="Dev5054ServiceRecoveryEvidence.cs" />
    <Compile Include="DevControlHostRuntimeConfiguration.cs" />
    <Compile Include="DevOperationalSchema.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\CanonicalWorkOrderIdentity.cs" Link="Operational\CanonicalWorkOrderIdentity.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\DevelopmentPermissionAuthorization.cs" Link="Operational\DevelopmentPermissionAuthorization.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\KittingCaseCenter.cs" Link="Operational\KittingCaseCenter.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\KittingCasePdfWriter.cs" Link="Operational\KittingCasePdfWriter.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\KittingDispositionCenter.cs" Link="Operational\KittingDispositionCenter.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\KittingDispositionRules.cs" Link="Operational\KittingDispositionRules.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\LegacyKittingMaterialStatusRepository.cs" Link="Operational\LegacyKittingMaterialStatusRepository.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\OperationalWorkOrderRelationshipCenter.cs" Link="Operational\OperationalWorkOrderRelationshipCenter.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\OperationsCenterVerifiedStatusCenter.cs" Link="Operational\OperationsCenterVerifiedStatusCenter.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\RmaReworkCenter.cs" Link="Operational\RmaReworkCenter.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\ShipmentStagingCenter.cs" Link="Operational\ShipmentStagingCenter.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\TrustedDevelopmentIdentity.cs" Link="Operational\TrustedDevelopmentIdentity.cs" />
    <Compile Include="..\..\LiveSnapshotRefresh\ControlHost\WorkOrderApprovalCenter.cs" Link="Operational\WorkOrderApprovalCenter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <ProjectReference Include="..\..\SecurityFoundation\DleOs.Security\DleOs.Security.csproj" />
    <ProjectReference Include="..\..\TrustedIdentity\DleOs.TrustedIdentity\DleOs.TrustedIdentity.csproj" />
    <Content Include="Start-DevOperationalControlHost5054.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
