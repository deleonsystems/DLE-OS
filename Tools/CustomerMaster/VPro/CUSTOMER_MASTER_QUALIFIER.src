0010 REM "CUSTOMER-MASTER-PLATFORM-001 fixed-path two-pass qualifier"
0020 REM "All live channels O_RDONLY; all generated output is local"
0030 SETESC 29000
0040 SETERR 29000
0050 LET RUN$="__RUN_ID__"
0060 LET ROOT$="__LAB_RUNTIME__\"
0070 LET Q$=$22$,CH10=0,CH11=0,OUT20=0,OUT21=0
0170 PRECISION 16
0180 DIM PCOUNT[8]
0190 DIM A0$(8),A1$(325)
0200 DIM B0$(10),B1$(64),BN[10]
0210 DIM C0$(14),C1$(190)
0220 DIM E0$(10),E1$(48)
0230 DIM F0$(8),F1$(16),FU[21]
0240 DIM G0$(18),G1$(167),GN[1]
0250 DIM T0$(7),T1$(32),TN[2]
0260 ARM01A: IOLIST A0$(1),A1$(1)
0270 ARM02A: IOLIST B0$(1),B1$(1),BN[ALL]
0280 ARM03A: IOLIST C0$(1),C1$(1)
0290 ARM05A: IOLIST E0$(1),E1$(1)
0300 ARM06A: IOLIST F0$(1),F1$(1),FU[ALL]
0310 ARM09A: IOLIST G0$(1),G1$(1),GN[ALL]
0320 ARM10A: IOLIST T0$(1),T1$(1),TN[ALL]
0330 ARM10F: IOLIST T0$(1),T1$(1),TN[0]
0340 ARM10H: IOLIST T0$(1),T1$(1)
0350 ARM10L: IOLIST T0$(1),T1$(1)
0360 ARM10M: IOLIST T0$(1),T1$(1)
0370 LET SUM$=ROOT$+"SOURCE_PASS_SUMMARY.csv",VER$=ROOT$+"RUNTIME_VERDICT.txt"
0380 OPEN (20,MODE="O_CREATE,O_TRUNC",ERR=29200)SUM$;LET OUT20=1
0390 PRINT (20)"pass,source,path,fid_before_hex,fid_after_hex,record_length,key_length,fin_before,count,fin_after,first_key_hex,last_key_hex,mode,identity,key_order"
0400 FOR PASS=1 TO 2
0410 FOR FILE=1 TO 8
0420 GOSUB 1000
0430 NEXT FILE
0440 NEXT PASS
0450 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)VER$;LET OUT21=1
0460 PRINT (21)"mission="+RUN$
0470 PRINT (21)"two_complete_passes=PASS"
0480 PRINT (21)"source_open_mode=O_RDONLY"
0490 PRINT (21)"source_writes=NONE"
0500 PRINT (21)"source_locks=NONE"
0510 PRINT (21)"qualification_verdict=PASS"
0520 CLOSE (21);LET OUT21=0
0530 CLOSE (20);LET OUT20=0
0540 RELEASE

1000 IF FILE=1 THEN LET NAME$="ARM-01",PATH$="X:\AON\ADATA\ARM-01",ERLEN=352,EKLEN=8
1002 IF FILE=2 THEN LET NAME$="ARM-02",PATH$="X:\AON\ADATA\ARM-02",ERLEN=160,EKLEN=10
1004 IF FILE=3 THEN LET NAME$="ARM-03",PATH$="X:\AON\ADATA\ARM-03",ERLEN=224,EKLEN=14
1006 IF FILE=4 THEN LET NAME$="ARM-05",PATH$="X:\AON\ADATA\ARM-05",ERLEN=64,EKLEN=10
1008 IF FILE=5 THEN LET NAME$="ARM-06",PATH$="X:\AON\ADATA\ARM-06",ERLEN=208,EKLEN=8
1010 IF FILE=6 THEN LET NAME$="ARM-09",PATH$="X:\AON\ADATA\ARM-09",ERLEN=224,EKLEN=18
1012 IF FILE=7 THEN LET NAME$="ARM-10",PATH$="X:\AON\ADATA\ARM-10",ERLEN=256,EKLEN=7
1014 IF FILE=8 THEN LET NAME$="ARM-14",PATH$="X:\AON\ADATA\ARM-14",ERLEN=32,EKLEN=22
1016 LET COUNT=0,FIRST$="",LAST$="",PREV$="",KEYORDER=1
1020 LET PDIR$=ROOT$+"Pass"+STR(PASS)+"\",OUT$=PDIR$+NAME$+".csv"
1030 OPEN (10,MODE="O_RDONLY",ERR=29100)PATH$;LET CH10=1
1040 OPEN (11,MODE="O_RDONLY",ERR=29100)PATH$;LET CH11=1
1050 LET FID1$=FID(10),FID11$=FID(11),FIN1$=FIN(10),OTYPE=MOD(ASC(FID1$(1,1)),32)
1060 LET ORLEN=DEC(FID1$(7,2)),OKLEN=ASC(FID1$(2,1)),ACTIVE1=DEC(FIN1$(77,4))
1070 IF FID1$<>FID11$ OR POS(NAME$=FID1$)=0 OR OTYPE<>6 OR ORLEN<>ERLEN OR OKLEN<>EKLEN THEN LET MSG$="identity/layout mismatch before read for "+NAME$;GOTO 29500
1080 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)OUT$;LET OUT21=1
1090 PRINT (21)"pass,source,key_hex,raw_record_hex,layout,decoded_material"
1095 LET K$=KEY(10,END=1800)
1100 IF COUNT>0 AND K$<=PREV$ THEN LET KEYORDER=0,MSG$="key order mismatch for "+NAME$;GOTO 29500
1110 IF COUNT=0 THEN LET FIRST$=K$
1120 LET LAST$=K$,PREV$=K$,MAT$="",LAYOUT$="A"
1130 READ RECORD(10,ERR=29400)R$
1140 IF FILE=1 THEN READ (11,KEY=K$,DOM=29400)IOL=ARM01A;LET MAT$="S"+HTA(A0$)+"|S"+HTA(A1$)
1150 IF FILE=2 THEN READ (11,KEY=K$,DOM=29400)IOL=ARM02A;LET MAT$="S"+HTA(B0$)+"|S"+HTA(B1$);GOSUB 4000
1160 IF FILE=3 THEN READ (11,KEY=K$,DOM=29400)IOL=ARM03A;LET MAT$="S"+HTA(C0$)+"|S"+HTA(C1$)
1170 IF FILE=4 THEN READ (11,KEY=K$,DOM=29400)IOL=ARM05A;LET MAT$="S"+HTA(E0$)+"|S"+HTA(E1$)
1180 IF FILE=5 THEN READ (11,KEY=K$,DOM=29400)IOL=ARM06A;LET MAT$="S"+HTA(F0$)+"|S"+HTA(F1$);GOSUB 4100
1190 IF FILE=6 THEN READ (11,KEY=K$,DOM=29400)IOL=ARM09A;LET MAT$="S"+HTA(G0$)+"|S"+HTA(G1$);GOSUB 4200
1200 IF FILE=7 THEN GOSUB 5000
1210 IF FILE=8 THEN LET LAYOUT$=K$(3,1),MAT$="K"+HTA(K$)
1220 IF K$<>A0$(1,8) AND FILE=1 THEN LET MSG$="ARM-01 decoded key mismatch";GOTO 29500
1230 IF K$<>B0$(1,10) AND FILE=2 THEN LET MSG$="ARM-02 decoded key mismatch";GOTO 29500
1240 IF K$<>C0$(1,14) AND FILE=3 THEN LET MSG$="ARM-03 decoded key mismatch";GOTO 29500
1250 IF K$<>E0$(1,10) AND FILE=4 THEN LET MSG$="ARM-05 decoded key mismatch";GOTO 29500
1260 IF K$<>F0$(1,8) AND FILE=5 THEN LET MSG$="ARM-06 decoded key mismatch";GOTO 29500
1270 IF K$<>G0$(1,18) AND FILE=6 THEN LET MSG$="ARM-09 decoded key mismatch";GOTO 29500
1280 LET COUNT=COUNT+1
1290 PRINT (21)STR(PASS)+","+Q$+NAME$+Q$+","+Q$+HTA(K$)+Q$+","+Q$+HTA(R$)+Q$+","+Q$+LAYOUT$+Q$+","+Q$+MAT$+Q$
1300 GOTO 1095
1800 LET FID2$=FID(10),FIN2$=FIN(10),ACTIVE2=DEC(FIN2$(77,4))
1810 CLOSE (10);LET CH10=0
1820 CLOSE (11);LET CH11=0
1830 CLOSE (21);LET OUT21=0
1840 IF FID1$<>FID2$ OR ACTIVE1<>ACTIVE2 OR COUNT<>ACTIVE1 THEN LET MSG$="identity/count changed within pass for "+NAME$;GOTO 29500
1850 IF PASS=2 AND COUNT<>PCOUNT[FILE] THEN LET MSG$="cross-pass count mismatch for "+NAME$;GOTO 29500
1860 IF PASS=1 THEN LET PCOUNT[FILE]=COUNT
1870 LET LINE$=STR(PASS)+","+Q$+NAME$+Q$+","+Q$+PATH$+Q$+","+Q$+HTA(FID1$)+Q$+","+Q$+HTA(FID2$)+Q$
1880 LET LINE$=LINE$+","+STR(ORLEN)+","+STR(OKLEN)+","+STR(ACTIVE1)+","+STR(COUNT)+","+STR(ACTIVE2)
1890 LET LINE$=LINE$+","+Q$+HTA(FIRST$)+Q$+","+Q$+HTA(LAST$)+Q$+","+Q$+"O_RDONLY"+Q$+","+Q$+"PASS"+Q$+","+Q$+"PASS"+Q$
1900 PRINT (20)LINE$
1910 RETURN

4000 FOR X=0 TO 10
4010 LET MAT$=MAT$+"|N"+STR(BN[X])
4020 NEXT X
4030 RETURN
4100 FOR X=0 TO 21
4110 LET MAT$=MAT$+"|N"+STR(FU[X])
4120 NEXT X
4130 RETURN
4200 FOR X=0 TO 1
4210 LET MAT$=MAT$+"|N"+STR(GN[X])
4220 NEXT X
4230 RETURN

5000 IF LEN(K$)<3 THEN LET MSG$="ARM-10 key too short";GOTO 29500
5010 LET LAYOUT$=K$(3,1),MAT$="K"+HTA(K$)
5020 IF LAYOUT$="A" THEN READ (11,KEY=K$,DOM=29400)IOL=ARM10A;LET MAT$="S"+HTA(T0$)+"|S"+HTA(T1$)+"|N"+STR(TN[0])+"|N"+STR(TN[1])+"|N"+STR(TN[2])
5030 IF LAYOUT$="F" THEN READ (11,KEY=K$,DOM=29400)IOL=ARM10F;LET MAT$="S"+HTA(T0$)+"|S"+HTA(T1$)+"|N"+STR(TN[0])
5040 IF LAYOUT$="H" THEN READ (11,KEY=K$,DOM=29400)IOL=ARM10H;LET MAT$="S"+HTA(T0$)+"|S"+HTA(T1$)
5050 IF LAYOUT$="L" THEN READ (11,KEY=K$,DOM=29400)IOL=ARM10L;LET MAT$="S"+HTA(T0$)+"|S"+HTA(T1$)
5060 IF LAYOUT$="M" THEN READ (11,KEY=K$,DOM=29400)IOL=ARM10M;LET MAT$="S"+HTA(T0$)+"|S"+HTA(T1$)
5070 RETURN

29000 LET MSG$="unexpected runtime error "+STR(ERR)
29010 GOTO 29500
29100 LET MSG$="O_RDONLY source open failed for "+NAME$+" error "+STR(ERR)
29110 GOTO 29500
29200 LET MSG$="approved local output open failed error "+STR(ERR)
29210 GOTO 29500
29400 LET MSG$="record read/decode failed for "+NAME$+" error "+STR(ERR)
29410 GOTO 29500
29500 IF CH10=1 THEN CLOSE (10)
29510 IF CH11=1 THEN CLOSE (11)
29520 IF OUT21=1 THEN CLOSE (21)
29530 IF OUT20=1 THEN PRINT (20)"FAIL,"+Q$+NAME$+Q$+","+Q$+MSG$+Q$;CLOSE (20)
29540 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29570)VER$
29550 PRINT (21)"qualification_verdict=FAIL";PRINT (21)"failure="+MSG$;CLOSE (21)
29560 ESCAPE
29570 PRINT "qualification failed and local verdict could not be written"
29580 ESCAPE
