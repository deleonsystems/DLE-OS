0010 REM "SUPPORTING-CODE-TABLES-PLATFORM-001 bounded two-pass qualifier"
0020 REM "All live source channels O_RDONLY; output contains operational codes only"
0030 SETESC 29000
0040 SETERR 29000
0050 PRECISION 16
0060 LET RUN$="__RUN_ID__"
0070 LET ROOT$="__LAB_RUNTIME__\"
0080 LET Q$=$22$,CH10=0,CH11=0,OUT20=0,OUT21=0
0090 DIM PCOUNT[9],PSELECT[9]
0100 LET SUM$=ROOT$+"SOURCE_PASS_SUMMARY.csv",VER$=ROOT$+"RUNTIME_VERDICT.txt"
0110 OPEN (20,MODE="O_CREATE,O_TRUNC",ERR=29200)SUM$;LET OUT20=1
0120 PRINT (20)"pass,source,path,fid_before_hex,fid_after_hex,record_length,key_length,fin_before,count,selected_count,fin_after,first_key_hex,last_key_hex,mode,identity,key_order,privacy_projection"
0130 FOR PASS=1 TO 2
0140 FOR FILE=1 TO 9
0150 GOSUB 1000
0160 NEXT FILE
0170 NEXT PASS
0180 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)VER$;LET OUT21=1
0190 PRINT (21)"mission="+RUN$
0200 PRINT (21)"two_complete_passes=PASS"
0210 PRINT (21)"source_open_mode=O_RDONLY"
0220 PRINT (21)"source_writes=NONE"
0230 PRINT (21)"source_locks=NONE"
0240 PRINT (21)"retained_projection=OPERATIONAL_CODE_ALLOWLIST_ONLY"
0250 PRINT (21)"payroll_security_accounting_fields_emitted=NONE"
0260 PRINT (21)"qualification_verdict=PASS"
0270 CLOSE (21);LET OUT21=0
0280 CLOSE (20);LET OUT20=0
0290 RELEASE

1000 IF FILE=1 THEN LET NAME$="ARM-10",PATH$="X:\AON\ADATA\ARM-10",ERLEN=256,EKLEN=7
1010 IF FILE=2 THEN LET NAME$="APM-10",PATH$="X:\AON\ADATA\APM-10",ERLEN=128,EKLEN=5
1020 IF FILE=3 THEN LET NAME$="IVM-10",PATH$="X:\AON\ADATA\IVM-10",ERLEN=256,EKLEN=10
1030 IF FILE=4 THEN LET NAME$="IVM-13",PATH$="X:\AON\ADATA\IVM-13",ERLEN=48,EKLEN=5
1040 IF FILE=5 THEN LET NAME$="POM-02",PATH$="X:\AON\ADATA\POM-02",ERLEN=64,EKLEN=6
1050 IF FILE=6 THEN LET NAME$="POM-03",PATH$="X:\AON\ADATA\POM-03",ERLEN=58,EKLEN=5
1060 IF FILE=7 THEN LET NAME$="PRM-10",PATH$="X:\AON\ADATA\PRM-10",ERLEN=672,EKLEN=6
1070 IF FILE=8 THEN LET NAME$="SYM-02",PATH$="X:\AON\ADATA\SYM-02",ERLEN=210,EKLEN=4
1080 IF FILE=9 THEN LET NAME$="WOM-10",PATH$="X:\AON\ADATA\WOM-10",ERLEN=160,EKLEN=5
1090 LET COUNT=0,SELECTED=0,FIRST$="",LAST$="",PREV$="",KEYORDER=1
1100 LET PDIR$=ROOT$+"Pass"+STR(PASS)+"\",OUT$=PDIR$+NAME$+"-safe.csv"
1110 OPEN (10,MODE="O_RDONLY",ERR=29100)PATH$;LET CH10=1
1120 OPEN (11,MODE="O_RDONLY",ERR=29100)PATH$;LET CH11=1
1130 LET FID1$=FID(10),FID11$=FID(11),FIN1$=FIN(10),OTYPE=MOD(ASC(FID1$(1,1)),32)
1140 LET ORLEN=DEC(FID1$(7,2)),OKLEN=ASC(FID1$(2,1)),ACTIVE1=DEC(FIN1$(77,4))
1150 IF FID1$<>FID11$ OR POS(NAME$=FID1$)=0 OR OTYPE<>6 OR ORLEN<>ERLEN OR OKLEN<>EKLEN THEN LET MSG$="identity/layout mismatch before read for "+NAME$;GOTO 29500
1160 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)OUT$;LET OUT21=1
1170 PRINT (21)"pass,source,key_hex,layout,firm_id_hex,code_value_hex,description_hex"
1180 LET K$=KEY(10,END=1800)
1190 IF COUNT>0 AND K$<=PREV$ THEN LET KEYORDER=0,MSG$="key order mismatch for "+NAME$;GOTO 29500
1200 IF COUNT=0 THEN LET FIRST$=K$
1210 LET LAST$=K$,PREV$=K$
1220 READ RECORD(10,ERR=29400)R$
1230 GOSUB 2000
1240 LET COUNT=COUNT+1
1250 GOTO 1180
1800 LET FID2$=FID(10),FIN2$=FIN(10),ACTIVE2=DEC(FIN2$(77,4))
1810 CLOSE (10);LET CH10=0
1820 CLOSE (11);LET CH11=0
1830 CLOSE (21);LET OUT21=0
1840 IF FID1$<>FID2$ OR ACTIVE1<>ACTIVE2 OR COUNT<>ACTIVE1 THEN LET MSG$="identity/count changed within pass for "+NAME$;GOTO 29500
1850 IF PASS=2 AND (COUNT<>PCOUNT[FILE] OR SELECTED<>PSELECT[FILE]) THEN LET MSG$="cross-pass count mismatch for "+NAME$;GOTO 29500
1860 IF PASS=1 THEN LET PCOUNT[FILE]=COUNT,PSELECT[FILE]=SELECTED
1870 LET LINE$=STR(PASS)+","+Q$+NAME$+Q$+","+Q$+PATH$+Q$+","+Q$+HTA(FID1$)+Q$+","+Q$+HTA(FID2$)+Q$
1880 LET LINE$=LINE$+","+STR(ORLEN)+","+STR(OKLEN)+","+STR(ACTIVE1)+","+STR(COUNT)+","+STR(SELECTED)+","+STR(ACTIVE2)
1890 LET LINE$=LINE$+","+Q$+HTA(FIRST$)+Q$+","+Q$+HTA(LAST$)+Q$+","+Q$+"O_RDONLY"+Q$+","+Q$+"PASS"+Q$+","+Q$+"PASS"+Q$+","+Q$+"ALLOWLIST_ONLY"+Q$
1900 PRINT (20)LINE$
1910 RETURN

2000 LET LAYOUT$="",FIRM$="",CODE$="",DESC$=""
2010 IF FILE=1 OR FILE=2 OR FILE=3 OR FILE=7 OR FILE=9 THEN LET LAYOUT$=K$(3,1),FIRM$=K$(1,2),CODE$=K$(4)
2020 IF FILE=4 OR FILE=5 OR FILE=6 THEN LET LAYOUT$="A",FIRM$=K$(1,2),CODE$=K$(3)
2030 IF FILE=8 THEN LET LAYOUT$="A",FIRM$="",CODE$=K$(1,3)
2040 IF FILE=1 AND POS(LAYOUT$="AEFHLM")=0 THEN RETURN
2050 IF FILE=2 AND LAYOUT$<>"C" THEN RETURN
2060 IF FILE=3 AND POS(LAYOUT$="ABCF")=0 THEN RETURN
2070 IF FILE=7 AND POS(LAYOUT$="EF")=0 THEN RETURN
2080 IF FILE=9 AND LAYOUT$<>"A" THEN RETURN
2090 LET DLEN=20
2100 IF FILE=3 AND LAYOUT$="C" THEN LET DLEN=24
2110 IF FILE=6 THEN LET DLEN=30
2120 IF FILE=8 THEN LET DLEN=24
2130 IF LEN(R$)<LEN(K$)+DLEN THEN LET MSG$="approved projection shorter than expected for "+NAME$;GOTO 29500
2140 LET DESC$=R$(LEN(K$)+1,DLEN)
2150 LET LINE$=STR(PASS)+","+Q$+NAME$+Q$+","+Q$+HTA(K$)+Q$+","+Q$+LAYOUT$+Q$
2160 LET LINE$=LINE$+","+Q$+HTA(FIRM$)+Q$+","+Q$+HTA(CODE$)+Q$+","+Q$+HTA(DESC$)+Q$
2170 PRINT (21)LINE$;LET SELECTED=SELECTED+1
2180 RETURN

29000 LET MSG$="unexpected runtime error "+STR(ERR)
29010 GOTO 29500
29100 LET MSG$="O_RDONLY source open failed for "+NAME$+" error "+STR(ERR)
29110 GOTO 29500
29200 LET MSG$="approved local output open failed error "+STR(ERR)
29210 GOTO 29500
29400 LET MSG$="record read/decode failed for "+NAME$+" error "+STR(ERR)
29410 GOTO 29500
29500 IF CH10=1 THEN CLOSE (10)
29510 IF CH11=1 THEN CLOSE (11)
29520 IF OUT21=1 THEN CLOSE (21)
29530 IF OUT20=1 THEN PRINT (20)"FAIL,"+Q$+NAME$+Q$+","+Q$+MSG$+Q$;CLOSE (20)
29540 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29570)VER$
29550 PRINT (21)"qualification_verdict=FAIL";PRINT (21)"failure="+MSG$;CLOSE (21)
29560 ESCAPE
29570 PRINT "qualification failed and local verdict could not be written"
29580 ESCAPE
