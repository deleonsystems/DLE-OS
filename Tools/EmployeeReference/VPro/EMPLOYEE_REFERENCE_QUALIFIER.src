0010 REM "EMPLOYEE-REFERENCE-PLATFORM-001 privacy-bounded two-pass qualifier"
0020 REM "All live channels O_RDONLY; retained rows contain allowlisted fields only"
0030 SETESC 29000
0040 SETERR 29000
0050 PRECISION 16
0060 LET RUN$="__RUN_ID__"
0070 LET ROOT$="__LAB_RUNTIME__\"
0080 LET Q$=$22$,CH10=0,CH11=0,OUT20=0,OUT21=0
0090 DIM PCOUNT[5],PSELECT[5]
0100 DIM A0$(11),A1$(240)
0110 DIM B0$(3),B1$(128),BN[4]
0120 DIM T0$(64),T1$(64),TN[0]
0130 DIM X0$(672)
0150 PRM01A: IOLIST A0$(1),A1$(1)
0160 PRM10E: IOLIST X0$
0170 PRM10F: IOLIST X0$
0180 SYM02A: IOLIST B0$(1),B1$(1),BN[ALL]
0190 ARM10F: IOLIST T0$,T1$,TN[0]
0200 IVM10F: IOLIST X0$
0210 LET SUM$=ROOT$+"SOURCE_PASS_SUMMARY.csv",VER$=ROOT$+"RUNTIME_VERDICT.txt"
0220 OPEN (20,MODE="O_CREATE,O_TRUNC",ERR=29200)SUM$;LET OUT20=1
0230 PRINT (20)"pass,source,path,fid_before_hex,fid_after_hex,record_length,key_length,fin_before,count,selected_count,fin_after,first_key_hex,last_key_hex,mode,identity,key_order,privacy_projection"
0240 FOR PASS=1 TO 2
0250 FOR FILE=1 TO 5
0260 GOSUB 1000
0270 NEXT FILE
0280 NEXT PASS
0290 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)VER$;LET OUT21=1
0300 PRINT (21)"mission="+RUN$
0310 PRINT (21)"two_complete_passes=PASS"
0320 PRINT (21)"source_open_mode=O_RDONLY"
0330 PRINT (21)"source_writes=NONE"
0340 PRINT (21)"source_locks=NONE"
0350 PRINT (21)"retained_projection=ALLOWLIST_ONLY"
0360 PRINT (21)"prohibited_fields_emitted=NONE"
0370 PRINT (21)"qualification_verdict=PASS"
0380 CLOSE (21);LET OUT21=0
0390 CLOSE (20);LET OUT20=0
0400 RELEASE

1000 IF FILE=1 THEN LET NAME$="PRM-01",PATH$="X:\AON\ADATA\PRM-01",ERLEN=256,EKLEN=11
1010 IF FILE=2 THEN LET NAME$="PRM-10",PATH$="X:\AON\ADATA\PRM-10",ERLEN=672,EKLEN=6
1020 IF FILE=3 THEN LET NAME$="SYM-02",PATH$="X:\AON\ADATA\SYM-02",ERLEN=210,EKLEN=4
1030 IF FILE=4 THEN LET NAME$="ARM-10",PATH$="X:\AON\ADATA\ARM-10",ERLEN=256,EKLEN=7
1040 IF FILE=5 THEN LET NAME$="IVM-10",PATH$="X:\AON\ADATA\IVM-10",ERLEN=256,EKLEN=10
1050 LET COUNT=0,SELECTED=0,FIRST$="",LAST$="",PREV$="",KEYORDER=1
1060 LET PDIR$=ROOT$+"Pass"+STR(PASS)+"\",OUT$=PDIR$+NAME$+"-safe.csv"
1070 OPEN (10,MODE="O_RDONLY",ERR=29100)PATH$;LET CH10=1
1080 OPEN (11,MODE="O_RDONLY",ERR=29100)PATH$;LET CH11=1
1090 LET FID1$=FID(10),FID11$=FID(11),FIN1$=FIN(10),OTYPE=MOD(ASC(FID1$(1,1)),32)
1100 LET ORLEN=DEC(FID1$(7,2)),OKLEN=ASC(FID1$(2,1)),ACTIVE1=DEC(FIN1$(77,4))
1110 IF FID1$<>FID11$ OR POS(NAME$=FID1$)=0 OR OTYPE<>6 OR ORLEN<>ERLEN OR OKLEN<>EKLEN THEN LET MSG$="identity/layout mismatch before read for "+NAME$;GOTO 29500
1120 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)OUT$;LET OUT21=1
1130 GOSUB 2000
1140 LET K$=KEY(10,END=1800)
1150 IF COUNT>0 AND K$<=PREV$ THEN LET KEYORDER=0,MSG$="key order mismatch for "+NAME$;GOTO 29500
1160 IF COUNT=0 THEN LET FIRST$=K$
1170 LET LAST$=K$,PREV$=K$
1180 READ RECORD(10,ERR=29400)R$
1190 IF FILE=1 THEN GOSUB 3000
1200 IF FILE=2 THEN GOSUB 3100
1210 IF FILE=3 THEN GOSUB 3200
1220 IF FILE=4 THEN GOSUB 3300
1230 IF FILE=5 THEN GOSUB 3400
1240 LET COUNT=COUNT+1
1250 GOTO 1140
1800 LET FID2$=FID(10),FIN2$=FIN(10),ACTIVE2=DEC(FIN2$(77,4))
1810 CLOSE (10);LET CH10=0
1820 CLOSE (11);LET CH11=0
1830 CLOSE (21);LET OUT21=0
1840 IF FID1$<>FID2$ OR ACTIVE1<>ACTIVE2 OR COUNT<>ACTIVE1 THEN LET MSG$="identity/count changed within pass for "+NAME$;GOTO 29500
1850 IF PASS=2 AND (COUNT<>PCOUNT[FILE] OR SELECTED<>PSELECT[FILE]) THEN LET MSG$="cross-pass count mismatch for "+NAME$;GOTO 29500
1860 IF PASS=1 THEN LET PCOUNT[FILE]=COUNT,PSELECT[FILE]=SELECTED
1870 LET LINE$=STR(PASS)+","+Q$+NAME$+Q$+","+Q$+PATH$+Q$+","+Q$+HTA(FID1$)+Q$+","+Q$+HTA(FID2$)+Q$
1880 LET LINE$=LINE$+","+STR(ORLEN)+","+STR(OKLEN)+","+STR(ACTIVE1)+","+STR(COUNT)+","+STR(SELECTED)+","+STR(ACTIVE2)
1890 LET LINE$=LINE$+","+Q$+HTA(FIRST$)+Q$+","+Q$+HTA(LAST$)+Q$+","+Q$+"O_RDONLY"+Q$+","+Q$+"PASS"+Q$+","+Q$+"PASS"+Q$+","+Q$+"ALLOWLIST_ONLY"+Q$
1900 PRINT (20)LINE$
1910 RETURN

2000 IF FILE=1 THEN PRINT (21)"pass,source,key_hex,firm_id_hex,employee_number_hex,last_name_hex,first_name_hex,department_code_hex,title_code_hex,is_active"
2010 IF FILE=2 THEN PRINT (21)"pass,source,key_hex,code_type,firm_id_hex,operational_code_hex,description_hex"
2020 IF FILE=3 THEN PRINT (21)"pass,source,key_hex,code_type,operational_code_hex,description_hex"
2030 IF FILE=4 THEN PRINT (21)"pass,source,key_hex,code_type,firm_id_hex,operational_code_hex,description_hex"
2040 IF FILE=5 THEN PRINT (21)"pass,source,key_hex,code_type,firm_id_hex,operational_code_hex,description_hex"
2050 RETURN

3000 READ (11,KEY=K$,DOM=29400)IOL=PRM01A
3010 IF K$<>A0$(1,11) THEN LET MSG$="PRM-01 decoded key mismatch";GOTO 29500
3020 LET ACTIVE$="1"
3030 IF A1$(170,3)<>$202020$ THEN LET ACTIVE$="0"
3040 LET LINE$=STR(PASS)+","+Q$+"PRM-01"+Q$+","+Q$+HTA(K$)+Q$+","+Q$+HTA(A0$(1,2))+Q$+","+Q$+HTA(A0$(3,9))+Q$
3050 LET LINE$=LINE$+","+Q$+HTA(A1$(1,16))+Q$+","+Q$+HTA(A1$(17,14))+Q$+","+Q$+HTA(A1$(221,2))+Q$+","+Q$+HTA(A1$(223,2))+Q$+","+ACTIVE$
3060 PRINT (21)LINE$;LET SELECTED=SELECTED+1
3070 RETURN

3100 IF LEN(K$)<3 THEN LET MSG$="PRM-10 key too short";GOTO 29500
3110 LET LAYOUT$=K$(3,1)
3120 IF LAYOUT$<>"E" AND LAYOUT$<>"F" THEN RETURN
3130 IF LAYOUT$="E" THEN READ (11,KEY=K$,DOM=29400)IOL=PRM10E
3140 IF LAYOUT$="F" THEN READ (11,KEY=K$,DOM=29400)IOL=PRM10F
3150 LET TYPE$="Department"
3160 IF LAYOUT$="F" THEN LET TYPE$="JobTitle"
3170 LET LINE$=STR(PASS)+","+Q$+"PRM-10"+Q$+","+Q$+HTA(K$)+Q$+","+Q$+TYPE$+Q$+","+Q$+HTA(K$(1,2))+Q$
3180 LET LINE$=LINE$+","+Q$+HTA(K$(4))+Q$+","+Q$+HTA(X0$(6,20))+Q$
3190 PRINT (21)LINE$;LET SELECTED=SELECTED+1
3195 RETURN

3200 READ (11,KEY=K$,DOM=29400)IOL=SYM02A
3210 LET LINE$=STR(PASS)+","+Q$+"SYM-02"+Q$+","+Q$+HTA(K$)+Q$+","+Q$+"Operator"+Q$+","+Q$+HTA(B0$(1,3))+Q$+","+Q$+HTA(B1$(1,24))+Q$
3220 PRINT (21)LINE$;LET SELECTED=SELECTED+1
3230 RETURN

3300 IF LEN(K$)<3 OR K$(3,1)<>"F" THEN RETURN
3310 READ (11,KEY=K$,DOM=29400)IOL=ARM10F
3320 LET LINE$=STR(PASS)+","+Q$+"ARM-10"+Q$+","+Q$+HTA(K$)+Q$+","+Q$+"Salesperson"+Q$+","+Q$+HTA(K$(1,2))+Q$
3330 LET LINE$=LINE$+","+Q$+HTA(K$(4))+Q$+","+Q$+HTA(T0$(7,24))+Q$
3340 PRINT (21)LINE$;LET SELECTED=SELECTED+1
3350 RETURN

3400 IF LEN(K$)<3 OR K$(3,1)<>"F" THEN RETURN
3410 READ (11,KEY=K$,DOM=29400)IOL=IVM10F
3420 LET LINE$=STR(PASS)+","+Q$+"IVM-10"+Q$+","+Q$+HTA(K$)+Q$+","+Q$+"Buyer"+Q$+","+Q$+HTA(K$(1,2))+Q$
3430 LET LINE$=LINE$+","+Q$+HTA(K$(4))+Q$+","+Q$+HTA(X0$(7,20))+Q$
3440 PRINT (21)LINE$;LET SELECTED=SELECTED+1
3450 RETURN

29000 LET MSG$="unexpected runtime error "+STR(ERR)
29010 GOTO 29500
29100 LET MSG$="O_RDONLY source open failed for "+NAME$+" error "+STR(ERR)
29110 GOTO 29500
29200 LET MSG$="approved local output open failed error "+STR(ERR)
29210 GOTO 29500
29400 LET MSG$="record read/decode failed for "+NAME$+" error "+STR(ERR)
29410 GOTO 29500
29500 IF CH10=1 THEN CLOSE (10)
29510 IF CH11=1 THEN CLOSE (11)
29520 IF OUT21=1 THEN CLOSE (21)
29530 IF OUT20=1 THEN PRINT (20)"FAIL,"+Q$+NAME$+Q$+","+Q$+MSG$+Q$;CLOSE (20)
29540 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29570)VER$
29550 PRINT (21)"qualification_verdict=FAIL";PRINT (21)"failure="+MSG$;CLOSE (21)
29560 ESCAPE
29570 PRINT "qualification failed and local verdict could not be written"
29580 ESCAPE
