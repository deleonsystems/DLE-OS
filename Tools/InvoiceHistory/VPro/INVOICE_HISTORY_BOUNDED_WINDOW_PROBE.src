0010 REM "INVOICE-HISTORY-REFRESH-001 bounded window proof"
0020 REM "Fixed live allowlist; every source open MODE=O_RDONLY"
0030 REM "ART-03 header scan drives exact-prefix ART-13 reads"
0040 SETERR 29000
0050 PRECISION 16
0060 LET ROOT$="C:\Add-On\Lab\InvoiceHistoryRefresh001\INVOICEHISTORYREFRESH001-20260729T135205Z\"
0070 LET ART03$="X:\AON\ADATA\ART-03",ART13$="X:\AON\ADATA\ART-13"
0080 LET STARTDATE=260615,ENDDATE=260729,Q$=$22$
0090 LET C10=0,C11=0,C12=0,C13=0,O20=0,O21=0,O22=0
0100 DIM A0$(117),AN[10],W0$(52),W1$(64),WN[14]
0110 ART03A: IOLIST A0$(1),AN[ALL]
0120 ART13A: IOLIST W0$(1),W1$(1),WN[ALL]
0130 OPEN (20,MODE="O_CREATE,O_TRUNC",ERR=29200)ROOT$+"BOUNDED_HEADERS.csv";LET O20=1
0140 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)ROOT$+"BOUNDED_LINES.csv";LET O21=1
0150 OPEN (22,MODE="O_CREATE,O_TRUNC",ERR=29200)ROOT$+"BOUNDED_SUMMARY.csv";LET O22=1
0160 PRINT (20)"key_hex,record_hex,a0_hex,numeric_values,invoice_date_number"
0170 PRINT (21)"key_hex,record_hex,w0_hex,w1_hex,numeric_values"
0180 PRINT (22)"metric,value"
0190 OPEN (10,MODE="O_RDONLY",ERR=29100)ART03$;LET C10=1
0200 OPEN (11,MODE="O_RDONLY",ERR=29100)ART03$;LET C11=1
0210 OPEN (12,MODE="O_RDONLY",ERR=29100)ART13$;LET C12=1
0220 OPEN (13,MODE="O_RDONLY",ERR=29100)ART13$;LET C13=1
0230 LET F03B$=FID(10),N03B$=FIN(10),F13B$=FID(12),N13B$=FIN(12)
0240 LET HEXAM=0,HSEL=0,HBYTES=0,LPROBE=0,LEXAM=0,LSEL=0,LBYTES=0,VOID=0,BLANK=0,INVALID=0,FUTURE=0
1000 LET K$=KEY(10,END=1800)
1010 READ RECORD(10,ERR=29400)R$
1020 READ (11,KEY=K$,DOM=29400)IOL=ART03A
1030 LET HEXAM=HEXAM+1,HBYTES=HBYTES+LEN(K$)+LEN(R$)
1040 IF A0$(21,1)="V" THEN LET VOID=VOID+1;GOTO 1000
1050 LET D$=A0$(24,3)
1060 IF D$="   " THEN LET BLANK=BLANK+1;GOTO 1000
1070 LET YY=MOD(ASC(D$(1,1))-32,100),MM=MOD(ASC(D$(2,1))-32,100),DD=MOD(ASC(D$(3,1))-32,100)
1080 IF MM<1 OR MM>12 OR DD<1 OR DD>31 THEN LET INVALID=INVALID+1;GOTO 1000
1090 LET DNUM=YY*10000+MM*100+DD
1100 IF DNUM>ENDDATE THEN LET FUTURE=FUTURE+1;GOTO 1000
1110 IF DNUM<STARTDATE THEN GOTO 1000
1120 LET HSEL=HSEL+1,NUMS$=""
1130 FOR X=0 TO 10
1140 LET NUMS$=NUMS$+STR(AN[X])
1150 IF X<10 THEN LET NUMS$=NUMS$+"|"
1160 NEXT X
1170 PRINT (20)Q$+HTA(K$)+Q$+","+Q$+HTA(R$)+Q$+","+Q$+HTA(A0$)+Q$+","+Q$+NUMS$+Q$+","+STR(DNUM)
1180 LET P$=K$(1,17)
1190 GOSUB 3000
1200 GOTO 1000
1800 LET F03A$=FID(10),N03A$=FIN(10),F13A$=FID(12),N13A$=FIN(12)
1810 PRINT (22)"overlap_start,2026-06-15"
1820 PRINT (22)"overlap_end,2026-07-29"
1830 PRINT (22)"art03_headers_examined,"+STR(HEXAM)
1840 PRINT (22)"art03_headers_selected,"+STR(HSEL)
1850 PRINT (22)"art03_bytes_read,"+STR(HBYTES)
1860 PRINT (22)"art03_void_headers,"+STR(VOID)
1870 PRINT (22)"art03_blank_dates,"+STR(BLANK)
1880 PRINT (22)"art03_invalid_dates,"+STR(INVALID)
1890 PRINT (22)"art03_future_dates,"+STR(FUTURE)
1895 PRINT (22)"art13_exact_key_probes,"+STR(LPROBE)
1900 PRINT (22)"art13_lines_examined,"+STR(LEXAM)
1910 PRINT (22)"art13_lines_selected,"+STR(LSEL)
1920 PRINT (22)"art13_bytes_read,"+STR(LBYTES)
1930 PRINT (22)"art03_fid_before_hex,"+HTA(F03B$)
1940 PRINT (22)"art03_fin_before_hex,"+HTA(N03B$)
1950 PRINT (22)"art03_fid_after_hex,"+HTA(F03A$)
1960 PRINT (22)"art03_fin_after_hex,"+HTA(N03A$)
1970 PRINT (22)"art13_fid_before_hex,"+HTA(F13B$)
1980 PRINT (22)"art13_fin_before_hex,"+HTA(N13B$)
1990 PRINT (22)"art13_fid_after_hex,"+HTA(F13A$)
2000 PRINT (22)"art13_fin_after_hex,"+HTA(N13A$)
2010 PRINT (22)"open_mode,O_RDONLY"
2020 CLOSE (10);LET C10=0
2030 CLOSE (11);LET C11=0
2040 CLOSE (12);LET C12=0
2050 CLOSE (13);LET C13=0
2060 CLOSE (20);LET O20=0
2070 CLOSE (21);LET O21=0
2080 CLOSE (22);LET O22=0
2090 PRINT "INVOICE HISTORY bounded window probe PASS"
2100 RELEASE
3000 FOR LN=0 TO 999
3010 LET LKEY$=P$+STR(LN:"000"),LPROBE=LPROBE+1
3020 READ RECORD(12,KEY=LKEY$,DOM=3090)LR$
3030 READ (13,KEY=LKEY$,DOM=29400)IOL=ART13A
3040 LET LEXAM=LEXAM+1,LSEL=LSEL+1,LBYTES=LBYTES+LEN(LKEY$)+LEN(LR$),LNUMS$=""
3050 FOR X=0 TO 14
3060 LET LNUMS$=LNUMS$+STR(WN[X])
3070 IF X<14 THEN LET LNUMS$=LNUMS$+"|"
3080 NEXT X
3085 PRINT (21)Q$+HTA(LKEY$)+Q$+","+Q$+HTA(LR$)+Q$+","+Q$+HTA(W0$)+Q$+","+Q$+HTA(W1$)+Q$+","+Q$+LNUMS$+Q$
3090 NEXT LN
3100 RETURN
3900 RETURN
29000 LET MSG$="runtime error "+STR(ERR)+" at "+STR(TCB(5));GOTO 29500
29100 LET MSG$="O_RDONLY source open failed error "+STR(ERR);GOTO 29500
29200 LET MSG$="approved local output open failed "+STR(ERR);GOTO 29500
29400 LET MSG$="record read/decode failed error "+STR(ERR);GOTO 29500
29500 IF C10=1 THEN CLOSE (10)
29510 IF C11=1 THEN CLOSE (11)
29520 IF C12=1 THEN CLOSE (12)
29530 IF C13=1 THEN CLOSE (13)
29540 IF O20=1 THEN CLOSE (20)
29550 IF O21=1 THEN CLOSE (21)
29560 IF O22=1 THEN PRINT (22)"failure,"+Q$+MSG$+Q$;CLOSE (22)
29570 PRINT "INVOICE HISTORY bounded window probe FAIL: "+MSG$
29580 RELEASE
