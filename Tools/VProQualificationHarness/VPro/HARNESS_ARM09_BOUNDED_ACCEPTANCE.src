0010 REM "VPRO-QUALIFICATION-HARNESS-002 infrastructure acceptance"
0020 REM "ARM-09 is previously qualified; one record only; no business mapping"
0030 SETERR 9000
0040 LET RT$="__HARNESS_RUNTIME__\"
0050 LET S$="X:\AON\ADATA\ARM-09"
0060 OPEN (20,MODE="O_CREATE,O_TRUNC")RT$+"STARTED.marker"
0070 PRINT (20)"STARTED"
0080 CLOSE (20)
0090 OPEN (10,MODE="O_RDONLY",ERR=9000)S$
0100 LET K$=KEY(10,END=1000)
0110 READ RECORD(10,KEY=K$,ERR=9000)R$
0120 OPEN (21,MODE="O_CREATE,O_TRUNC")RT$+"PROGRESS.marker"
0130 PRINT (21)"records_examined=1"
0140 CLOSE (21)
1000 CLOSE (10)
1010 OPEN (22,MODE="O_CREATE,O_TRUNC")RT$+"COMPLETE.marker"
1020 PRINT (22)"PASS"
1030 CLOSE (22)
1040 RELEASE
9000 IF TCB(2)<>0 THEN CLOSE (10,ERR=9010)
9010 OPEN (23,MODE="O_CREATE,O_TRUNC",ERR=9030)RT$+"ERROR.marker"
9020 PRINT (23)"FAILED"
9030 RELEASE
