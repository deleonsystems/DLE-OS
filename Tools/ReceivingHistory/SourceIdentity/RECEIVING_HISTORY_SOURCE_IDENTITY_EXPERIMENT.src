0010 REM "RECEIVING-HISTORY-SOURCE-IDENTITY-001 controlled experiment"
0020 REM "Fixed POT sources; every source channel is O_RDONLY"
0030 SETESC 29000
0040 SETERR 29000
0050 PRECISION 16
0060 LET RUN$="__RUN_ID__"
0070 LET ROOT$="__LAB_RUNTIME__\"
0080 LET EX$="__EXPERIMENT_CODE__",LIM=__READ_LIMIT__
0090 LET Q$=$22$,CH10=0,OUT20=0,OUT21=0
0100 OPEN (20,MODE="O_CREATE,O_TRUNC",ERR=29200)ROOT$+"IDENTITY_OBSERVATIONS.csv";LET OUT20=1
0110 PRINT (20)"experiment,source,path,observation,fid_hex,fin_hex,fin_length,count,first_key_hex,last_key_hex,mode"
0120 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)ROOT$+"RECORD_STREAM.csv";LET OUT21=1
0130 PRINT (21)"experiment,source,ordinal,key_hex,raw_record_hex"
0140 IF EX$="A" THEN GOTO 2000
0150 FOR FILE=1 TO 3
0160 GOSUB 1000
0170 NEXT FILE
0180 GOTO 2100

1000 IF FILE=1 THEN LET NAME$="POT-03",PATH$="X:\AON\ADATA\POT-03"
1010 IF FILE=2 THEN LET NAME$="POT-04",PATH$="X:\AON\ADATA\POT-04"
1020 IF FILE=3 THEN LET NAME$="POT-14",PATH$="X:\AON\ADATA\POT-14"
1030 LET COUNT=0,FIRST$="",LAST$="",PREV$=""
1040 OPEN (10,MODE="O_RDONLY",ERR=29100)PATH$;LET CH10=1
1050 LET FID1$=FID(10),FIN1$=FIN(10)
1060 GOSUB 2400
1070 IF EX$="B" OR EX$="G" THEN GOTO 1800
1080 LET K$=KEY(10,END=1800)
1090 IF COUNT>0 AND K$<=PREV$ THEN LET MSG$="key order mismatch for "+NAME$;GOTO 29500
1100 IF COUNT=0 THEN LET FIRST$=K$
1110 LET LAST$=K$,PREV$=K$
1120 READ RECORD(10,ERR=29400)R$
1130 LET COUNT=COUNT+1
1140 PRINT (21)Q$+EX$+Q$+","+Q$+NAME$+Q$+","+STR(COUNT)+","+Q$+HTA(K$)+Q$+","+Q$+HTA(R$)+Q$
1150 IF LIM>0 AND COUNT>=LIM THEN GOTO 1800
1160 GOTO 1080
1800 LET FID2$=FID(10),FIN2$=FIN(10)
1810 LET OBS$="after_read_or_before_close",FX$=FID2$,NX$=FIN2$
1820 GOSUB 2450
1830 CLOSE (10);LET CH10=0
1840 IF EX$<>"B" THEN RETURN
1850 OPEN (10,MODE="O_RDONLY",ERR=29100)PATH$;LET CH10=1
1860 LET FX$=FID(10),NX$=FIN(10),OBS$="second_open_no_read"
1870 GOSUB 2450
1880 CLOSE (10);LET CH10=0
1890 RETURN

2000 FOR FILE=1 TO 3
2010 GOSUB 2300
2020 PRINT (20)Q$+EX$+Q$+","+Q$+NAME$+Q$+","+Q$+PATH$+Q$+","+Q$+"no_vpro_open"+Q$+","+Q$+Q$+","+Q$+Q$+",0,0,"+Q$+Q$+","+Q$+Q$+","+Q$+"NOT_OPENED"+Q$
2030 NEXT FILE

2100 CLOSE (21);LET OUT21=0
2110 CLOSE (20);LET OUT20=0
2120 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)ROOT$+"RUNTIME_VERDICT.txt";LET OUT21=1
2130 PRINT (21)"mission="+RUN$
2140 PRINT (21)"experiment="+EX$
2150 LET MODE$="O_RDONLY"
2160 IF EX$="A" THEN LET MODE$="NOT_OPENED"
2170 PRINT (21)"source_open_mode="+MODE$
2180 PRINT (21)"source_writes=NONE"
2190 PRINT (21)"source_locks=NONE"
2200 PRINT (21)"qualification_verdict=PASS"
2210 CLOSE (21);LET OUT21=0
2220 RELEASE

2300 IF FILE=1 THEN LET NAME$="POT-03",PATH$="X:\AON\ADATA\POT-03"
2310 IF FILE=2 THEN LET NAME$="POT-04",PATH$="X:\AON\ADATA\POT-04"
2320 IF FILE=3 THEN LET NAME$="POT-14",PATH$="X:\AON\ADATA\POT-14"
2330 RETURN

2400 LET OBS$="after_open_before_read",FX$=FID1$,NX$=FIN1$
2410 GOSUB 2450
2420 RETURN
2450 LET LINE$=Q$+EX$+Q$+","+Q$+NAME$+Q$+","+Q$+PATH$+Q$+","+Q$+OBS$+Q$
2460 LET LINE$=LINE$+","+Q$+HTA(FX$)+Q$+","+Q$+HTA(NX$)+Q$+","+STR(LEN(NX$))+","+STR(COUNT)
2470 LET LINE$=LINE$+","+Q$+HTA(FIRST$)+Q$+","+Q$+HTA(LAST$)+Q$+","+Q$+"O_RDONLY"+Q$
2480 PRINT (20)LINE$
2490 RETURN

29000 LET MSG$="unexpected runtime error "+STR(ERR)
29010 GOTO 29500
29100 LET MSG$="O_RDONLY source open failed for "+NAME$+" error "+STR(ERR)
29110 GOTO 29500
29200 LET MSG$="approved local output open failed error "+STR(ERR)
29210 GOTO 29500
29400 LET MSG$="record read failed for "+NAME$+" error "+STR(ERR)
29410 GOTO 29500
29500 IF CH10=1 THEN CLOSE (10)
29510 IF OUT21=1 THEN CLOSE (21)
29520 IF OUT20=1 THEN CLOSE (20)
29530 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29560)ROOT$+"RUNTIME_VERDICT.txt"
29540 PRINT (21)"qualification_verdict=FAIL";PRINT (21)"failure="+MSG$;CLOSE (21)
29550 ESCAPE
29560 PRINT "qualification failed and local verdict could not be written"
29570 ESCAPE
