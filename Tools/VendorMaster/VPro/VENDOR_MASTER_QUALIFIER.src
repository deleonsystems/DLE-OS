0010 REM "VENDOR-MASTER-PLATFORM-001 fixed-source two-pass qualifier"
0020 REM "All live channels O_RDONLY; all generated output is local"
0030 SETESC 29000
0040 SETERR 29000
0050 PRECISION 16
0060 LET RUN$="__RUN_ID__"
0070 LET ROOT$="__LAB_RUNTIME__\"
0080 LET Q$=$22$,CH10=0,OUT20=0,OUT21=0
0090 DIM PCOUNT[7]
0100 OPEN (20,MODE="O_CREATE,O_TRUNC",ERR=29200)ROOT$+"SOURCE_PASS_SUMMARY.csv";LET OUT20=1
0110 PRINT (20)"pass,source,path,fid_before_hex,fid_after_hex,fin_before_hex,fin_after_hex,count,first_key_hex,last_key_hex,mode,identity,key_order"
0120 FOR PASS=1 TO 2
0130 FOR FILE=1 TO 7
0140 GOSUB 1000
0150 NEXT FILE
0160 NEXT PASS
0170 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)ROOT$+"RUNTIME_VERDICT.txt";LET OUT21=1
0180 PRINT (21)"mission="+RUN$
0190 PRINT (21)"two_complete_passes=PASS"
0200 PRINT (21)"source_open_mode=O_RDONLY"
0210 PRINT (21)"source_writes=NONE"
0220 PRINT (21)"source_locks=NONE"
0230 PRINT (21)"qualification_verdict=PASS"
0240 CLOSE (21);LET OUT21=0
0250 CLOSE (20);LET OUT20=0
0260 RELEASE

1000 IF FILE=1 THEN LET NAME$="APM-01",PATH$="X:\AON\ADATA\APM-01"
1010 IF FILE=2 THEN LET NAME$="APM-02",PATH$="X:\AON\ADATA\APM-02"
1020 IF FILE=3 THEN LET NAME$="APM-05",PATH$="X:\AON\ADATA\APM-05"
1030 IF FILE=4 THEN LET NAME$="APM-06",PATH$="X:\AON\ADATA\APM-06"
1040 IF FILE=5 THEN LET NAME$="APM-09",PATH$="X:\AON\ADATA\APM-09"
1050 IF FILE=6 THEN LET NAME$="APM-10",PATH$="X:\AON\ADATA\APM-10"
1060 IF FILE=7 THEN LET NAME$="IVM-10",PATH$="X:\AON\ADATA\IVM-10"
1070 LET COUNT=0,FIRST$="",LAST$="",PREV$="",KEYORDER=1
1080 LET PDIR$=ROOT$+"Pass"+STR(PASS)+"\",OUT$=PDIR$+NAME$+".csv"
1090 OPEN (10,MODE="O_RDONLY",ERR=29100)PATH$;LET CH10=1
1100 LET FID1$=FID(10),FIN1$=FIN(10)
1110 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)OUT$;LET OUT21=1
1120 PRINT (21)"pass,source,key_hex,raw_record_hex"
1130 LET K$=KEY(10,END=1800)
1140 IF COUNT>0 AND K$<=PREV$ THEN LET KEYORDER=0,MSG$="key order mismatch for "+NAME$;GOTO 29500
1150 IF COUNT=0 THEN LET FIRST$=K$
1160 LET LAST$=K$,PREV$=K$
1170 READ RECORD(10,ERR=29400)R$
1180 LET COUNT=COUNT+1
1190 PRINT (21)STR(PASS)+","+Q$+NAME$+Q$+","+Q$+HTA(K$)+Q$+","+Q$+HTA(R$)+Q$
1200 GOTO 1130
1800 LET FID2$=FID(10),FIN2$=FIN(10)
1810 CLOSE (10);LET CH10=0
1820 CLOSE (21);LET OUT21=0
1830 IF FID1$<>FID2$ THEN LET MSG$="identity changed within pass for "+NAME$;GOTO 29500
1840 IF PASS=2 AND COUNT<>PCOUNT[FILE] THEN LET MSG$="cross-pass count mismatch for "+NAME$;GOTO 29500
1850 IF PASS=1 THEN LET PCOUNT[FILE]=COUNT
1860 LET LINE$=STR(PASS)+","+Q$+NAME$+Q$+","+Q$+PATH$+Q$+","+Q$+HTA(FID1$)+Q$+","+Q$+HTA(FID2$)+Q$
1870 LET LINE$=LINE$+","+Q$+HTA(FIN1$)+Q$+","+Q$+HTA(FIN2$)+Q$+","+STR(COUNT)
1880 LET LINE$=LINE$+","+Q$+HTA(FIRST$)+Q$+","+Q$+HTA(LAST$)+Q$+","+Q$+"O_RDONLY"+Q$+","+Q$+"PASS"+Q$+","+Q$+"PASS"+Q$
1890 PRINT (20)LINE$
1900 RETURN

29000 LET MSG$="unexpected runtime error "+STR(ERR)
29010 GOTO 29500
29100 LET MSG$="O_RDONLY source open failed for "+NAME$+" error "+STR(ERR)
29110 GOTO 29500
29200 LET MSG$="approved local output open failed error "+STR(ERR)
29210 GOTO 29500
29400 LET MSG$="record read failed for "+NAME$+" error "+STR(ERR)
29410 GOTO 29500
29500 IF CH10=1 THEN CLOSE (10)
29510 IF OUT21=1 THEN CLOSE (21)
29520 IF OUT20=1 THEN PRINT (20)"FAIL,"+Q$+NAME$+Q$+","+Q$+MSG$+Q$;CLOSE (20)
29530 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29560)ROOT$+"RUNTIME_VERDICT.txt"
29540 PRINT (21)"qualification_verdict=FAIL";PRINT (21)"failure="+MSG$;CLOSE (21)
29550 ESCAPE
29560 PRINT "qualification failed and local verdict could not be written"
29570 ESCAPE
