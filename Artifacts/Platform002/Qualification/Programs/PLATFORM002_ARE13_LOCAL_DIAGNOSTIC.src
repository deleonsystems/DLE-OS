0010 REM "PLATFORM-002 local ARE-13 adapter diagnostic; no live source"
0020 SETERR 9000
0030 LET PATH$="C:\Add-On\aontest\aon\ADATA\ARE-13"
0040 LET OUT$="C:\Add-On\Lab\Platform002\PLATFORM002-20260728T160509Z-SALESORDER1\Evidence\ARE13_LOCAL_DIAGNOSTIC.txt"
0050 DIM W1$(64),W[14]
0060 ARE13A: IOLIST W0$,W1$(1),W[ALL]
0070 OPEN (20,MODE="O_CREATE,O_TRUNC")OUT$
0080 OPEN (10,MODE="O_RDONLY")PATH$;OPEN (11,MODE="O_RDONLY")PATH$
0090 LET K$=KEY(10,END=8000)
0100 READ RECORD(10)R$
0105 READ (11,KEY=K$,DOM=8000)IOL=ARE13A
