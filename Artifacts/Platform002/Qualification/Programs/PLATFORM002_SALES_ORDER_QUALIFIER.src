0010 REM "PLATFORM-002 two-pass Sales Order source qualification"
0020 REM "Five fixed live sources; all live channels MODE=O_RDONLY; all output local"
0030 SETESC 29000
0040 SETERR 29000
0050 LET RUN$="PLATFORM002-20260728T163200Z-SALESORDER4"
0060 LET ROOT$="C:\Add-On\Lab\Platform002\PLATFORM002-20260728T163200Z-SALESORDER4\Runtime\"
0070 LET ARE03$="X:\AON\ADATA\ARE-03",ARE13$="X:\AON\ADATA\ARE-13",ARM01$="X:\AON\ADATA\ARM-01"
0080 LET ARM10$="X:\AON\ADATA\ARM-10",WOE03$="X:\AON\ADATA\WOE-03"
0090 LET SUM$=ROOT$+"SOURCE_PASS_SUMMARY.csv",VER$=ROOT$+"RUNTIME_VERDICT.txt"
0100 LET Q$=$22$,CH10=0,CH11=0,OUT20=0,OUT21=0,OUT22=0
0105 PRECISION 16
0110 DIM PFID$(5),PCNT[5],PQCOUNT[5],PFIRST$(5),PLAST$(5)
0120 DIM A0$(117),AN[10]
0130 DIM D0$(52),D1$(64),DN[14]
0140 DIM C0$(8),C1$(325)
0150 DIM X0$(32)
0160 ARE03A: IOLIST A0$(1),AN[ALL]
0170 ARE13A: IOLIST D0$(1),D1$(1),DN[ALL]
0180 ARM01A: IOLIST C0$(1),C1$(1)
0190 ARM10E: IOLIST X0$(1)
0200 OPEN (20,MODE="O_CREATE,O_TRUNC",ERR=29200)SUM$;LET OUT20=1
0210 OPEN (22,MODE="O_CREATE,O_TRUNC",ERR=29200)VER$;LET OUT22=1
0220 PRINT (20)"pass,source_file,full_path,fid_before_hex,fid_after_hex,type_code,record_length,key_length,fin_active_before,actual_record_count,fin_active_after,qualified_layout,qualified_record_count,first_key_hex,last_key_hex,source_open_mode,identity_status,key_order_status"
0230 FOR PASS=1 TO 2
0240 FOR FILE=1 TO 5
0250 GOSUB 1000
0260 NEXT FILE
0270 NEXT PASS
0280 PRINT (22)"mission="+RUN$
0290 PRINT (22)"two_complete_passes=PASS"
0300 PRINT (22)"source_open_mode=O_RDONLY"
0310 PRINT (22)"live_source_writes=NONE"
0320 PRINT (22)"qualification_verdict=PASS"
0330 CLOSE (20);LET OUT20=0
0340 CLOSE (22);LET OUT22=0
0350 PRINT "PLATFORM-002 Sales Order source qualification PASS"
0360 RELEASE

1000 IF FILE=1 THEN LET NAME$="ARE-03",PATH$=ARE03$,ERLEN=192,EKLEN=20,QLAYOUT$="A"
1010 IF FILE=2 THEN LET NAME$="ARE-13",PATH$=ARE13$,ERLEN=224,EKLEN=20,QLAYOUT$="A"
1020 IF FILE=3 THEN LET NAME$="ARM-01",PATH$=ARM01$,ERLEN=352,EKLEN=8,QLAYOUT$="A"
1030 IF FILE=4 THEN LET NAME$="ARM-10",PATH$=ARM10$,ERLEN=256,EKLEN=7,QLAYOUT$="E"
1040 IF FILE=5 THEN LET NAME$="WOE-03",PATH$=WOE03$,ERLEN=38,EKLEN=37,QLAYOUT$="B"
1050 IF PASS=1 AND FILE=1 THEN LET OUT$=ROOT$+"Pass1\ARE03_FULL.csv"
1060 IF PASS=1 AND FILE=2 THEN LET OUT$=ROOT$+"Pass1\ARE13_FULL.csv"
1070 IF PASS=1 AND FILE=3 THEN LET OUT$=ROOT$+"Pass1\ARM01_FULL.csv"
1080 IF PASS=1 AND FILE=4 THEN LET OUT$=ROOT$+"Pass1\ARM10_FULL.csv"
1090 IF PASS=1 AND FILE=5 THEN LET OUT$=ROOT$+"Pass1\WOE03_FULL.csv"
1100 IF PASS=2 AND FILE=1 THEN LET OUT$=ROOT$+"Pass2\ARE03_FULL.csv"
1110 IF PASS=2 AND FILE=2 THEN LET OUT$=ROOT$+"Pass2\ARE13_FULL.csv"
1120 IF PASS=2 AND FILE=3 THEN LET OUT$=ROOT$+"Pass2\ARM01_FULL.csv"
1130 IF PASS=2 AND FILE=4 THEN LET OUT$=ROOT$+"Pass2\ARM10_FULL.csv"
1140 IF PASS=2 AND FILE=5 THEN LET OUT$=ROOT$+"Pass2\WOE03_FULL.csv"
1150 LET COUNT=0,QCOUNT=0,FIRST$="",LAST$="",PREV$="",KEYORDER=1
1160 OPEN (10,MODE="O_RDONLY",ERR=29100)PATH$;LET CH10=1
1170 OPEN (11,MODE="O_RDONLY",ERR=29100)PATH$;LET CH11=1
1180 LET FID1$=FID(10),FID11$=FID(11),FIN1$=FIN(10),OTYPE=MOD(ASC(FID1$(1,1)),32)
1190 LET ORLEN=DEC(FID1$(7,2)),OKLEN=ASC(FID1$(2,1)),ACTIVE1=DEC(FIN1$(77,4))
1200 IF FID1$<>FID11$ OR POS(NAME$=FID1$)=0 OR OTYPE<>6 OR ORLEN<>ERLEN OR OKLEN<>EKLEN THEN LET MSG$="identity/layout mismatch before read for "+NAME$;GOTO 29500
1210 OPEN (21,MODE="O_CREATE,O_TRUNC",ERR=29200)OUT$;LET OUT21=1
1220 PRINT (21)"pass,source_file,source_key_hex,record_raw_hex,layout_id,decoded_record_material"
1230 LET K$=KEY(10,END=1800)
1240 IF COUNT>0 AND K$<=PREV$ THEN LET KEYORDER=0,MSG$="key order mismatch for "+NAME$;GOTO 29500
1250 IF COUNT=0 THEN LET FIRST$=K$
1260 LET LAST$=K$,PREV$=K$,MAT$="",LAYOUT$="A"
1270 READ RECORD(10,ERR=29400)R$
1280 IF FILE=1 THEN READ (11,KEY=K$,DOM=29400)IOL=ARE03A;GOSUB 3000
1290 IF FILE=2 THEN READ (11,KEY=K$,DOM=29400)IOL=ARE13A;GOSUB 4000
1300 IF FILE=3 THEN READ (11,KEY=K$,DOM=29400)IOL=ARM01A;GOSUB 5000
1310 IF FILE=4 THEN GOSUB 6000
1320 IF FILE=5 THEN GOSUB 7000
1330 LET COUNT=COUNT+1
1340 PRINT (21)STR(PASS)+","+Q$+NAME$+Q$+","+Q$+HTA(K$)+Q$+","+Q$+HTA(R$)+Q$+","+Q$+LAYOUT$+Q$+","+Q$+MAT$+Q$
1350 GOTO 1230
1800 LET FID2$=FID(10),FIN2$=FIN(10),ACTIVE2=DEC(FIN2$(77,4))
1810 CLOSE (10);LET CH10=0
1820 CLOSE (11);LET CH11=0
1830 CLOSE (21);LET OUT21=0
1840 IF FID1$<>FID2$ OR ACTIVE1<>ACTIVE2 OR COUNT<>ACTIVE1 THEN LET MSG$="count or identity mismatch within pass for "+NAME$;GOTO 29500
1850 IF PASS=1 THEN LET PFID$(FILE)=FID1$,PCNT[FILE]=COUNT,PQCOUNT[FILE]=QCOUNT,PFIRST$(FILE)=FIRST$,PLAST$(FILE)=LAST$
1860 REM "Cross-pass raw and decoded equality enforced by independent SHA-256 postprocess"
1870 LET LINE$=STR(PASS)+","+Q$+NAME$+Q$+","+Q$+PATH$+Q$+","+Q$+HTA(FID1$)+Q$+","+Q$+HTA(FID2$)+Q$
1880 LET LINE$=LINE$+","+STR(OTYPE)+","+STR(ORLEN)+","+STR(OKLEN)+","+STR(ACTIVE1)+","+STR(COUNT)+","+STR(ACTIVE2)
1890 LET LINE$=LINE$+","+Q$+QLAYOUT$+Q$+","+STR(QCOUNT)+","+Q$+HTA(FIRST$)+Q$+","+Q$+HTA(LAST$)+Q$
1900 LET LINE$=LINE$+","+Q$+"O_RDONLY"+Q$+","+Q$+"PASS"+Q$+","+Q$+"PASS"+Q$
1910 PRINT (20)LINE$
1920 RETURN

3000 IF LEN(A0$)<117 THEN LET A0$=A0$+FILL(117-LEN(A0$))
3010 IF K$<>A0$(1,20) THEN LET MSG$="decoded key mismatch for ARE-03";GOTO 29500
3020 LET MAT$="S"+HTA(A0$)
3030 FOR X=0 TO 10
3040 LET MAT$=MAT$+"|N"+STR(AN[X])
3050 NEXT X
3060 LET QCOUNT=QCOUNT+1,LAYOUT$="A"
3070 RETURN

4000 IF LEN(D0$)<52 THEN LET D0$=D0$+FILL(52-LEN(D0$))
4010 IF LEN(D1$)<64 THEN LET D1$=D1$+FILL(64-LEN(D1$))
4020 IF K$<>D0$(1,20) THEN LET MSG$="decoded key mismatch for ARE-13";GOTO 29500
4030 LET MAT$="S"+HTA(D0$)+"|S"+HTA(D1$)
4040 FOR X=0 TO 14
4050 LET MAT$=MAT$+"|N"+STR(DN[X])
4060 NEXT X
4070 LET QCOUNT=QCOUNT+1,LAYOUT$="A"
4080 RETURN

5000 IF LEN(C0$)<8 THEN LET C0$=C0$+FILL(8-LEN(C0$))
5010 IF LEN(C1$)<325 THEN LET C1$=C1$+FILL(325-LEN(C1$))
5020 IF K$<>C0$(1,8) THEN LET MSG$="decoded key mismatch for ARM-01";GOTO 29500
5030 LET MAT$="S"+HTA(C0$)+"|S"+HTA(C1$),QCOUNT=QCOUNT+1,LAYOUT$="A"
5040 RETURN

6000 IF LEN(K$)<3 THEN LET MSG$="ARM-10 key too short";GOTO 29500
6010 LET LAYOUT$=K$(3,1)
6020 IF LAYOUT$<>"E" THEN RETURN
6030 READ (11,KEY=K$,DOM=29400)IOL=ARM10E
6040 IF LEN(X0$)<32 THEN LET X0$=X0$+FILL(32-LEN(X0$))
6050 IF K$<>X0$(1,4) THEN LET MSG$="decoded key mismatch for ARM-10 E";GOTO 29500
6060 LET MAT$="S"+HTA(X0$),QCOUNT=QCOUNT+1
6070 RETURN

7000 IF LEN(K$)<3 THEN LET MSG$="WOE-03 key too short";GOTO 29500
7010 LET LAYOUT$=K$(3,1)
7020 IF LAYOUT$<>"B" THEN RETURN
7030 IF LEN(K$)<>28 THEN LET MSG$="WOE-03 B key length mismatch";GOTO 29500
7040 LET MAT$="K"+HTA(K$),QCOUNT=QCOUNT+1
7050 RETURN

29000 LET MSG$="unexpected runtime error "+STR(ERR)
29010 GOTO 29500
29100 LET MSG$="O_RDONLY source open failed for "+NAME$+" error "+STR(ERR)
29110 GOTO 29500
29200 LET MSG$="approved local output open failed error "+STR(ERR)
29210 GOTO 29500
29400 LET MSG$="record read/decode failed for "+NAME$+" error "+STR(ERR)
29410 GOTO 29500
29500 IF CH10=1 THEN CLOSE (10)
29510 IF CH11=1 THEN CLOSE (11)
29520 IF OUT21=1 THEN CLOSE (21)
29530 IF OUT20=1 THEN PRINT (20)"FAIL,"+Q$+NAME$+Q$+","+Q$+MSG$+Q$;CLOSE (20)
29540 IF OUT22=1 THEN PRINT (22)"qualification_verdict=FAIL";PRINT (22)"failure="+MSG$;CLOSE (22)
29550 PRINT "PLATFORM-002 qualification FAIL: "+MSG$
29560 ESCAPE
